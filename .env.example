# Environnement
NODE_ENV=development
PORT=3000

# PostgreSQL — données métier + tables Better Auth
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweeleads

# URLs
APP_URL=http://localhost:5173
AUTH_BASE_URL=http://localhost:3000

# Better Auth — secret de signature des sessions/cookies.
# Générer : openssl rand -base64 32   (min 32 caractères)
AUTH_SECRET=change-me-with-a-32-plus-char-random-secret

# Chiffrement des secrets (mailbox SMTP/IMAP, clés API sourcing) au repos.
# 32 octets en base64. Générer : openssl rand -base64 32
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes

# LLM : "cli" (claude -p, défaut) ou "api" (ANTHROPIC_API_KEY requis).
LLM_PROVIDER=cli
CLAUDE_CLI_BIN=claude
ANTHROPIC_API_KEY=

# Sourcing (enrichissement email). Facultatif — sinon le Chasseur ne source pas.
HUNTER_API_KEY=

# Redis (BullMQ) — batch du soir + polling des réponses.
REDIS_URL=redis://localhost:6379

# Démarrer les workers BullMQ au boot (batch nocturne + reward). false en dev sans Redis.
RUN_WORKERS=true
