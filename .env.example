# ─────────────────────────────────────────────────────────────
# Tanchi — single .env for the whole monorepo.
# Copy to `.env` and fill in. Used by BOTH:
#   - local dev (`bun run dev`) — reads DATABASE_URL / REDIS_URL below
#   - docker compose — builds DATABASE_URL / REDIS_URL from POSTGRES_* and the
#     service hostnames, overriding the localhost values below inside the containers.
# Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ── Local dev connections (used by `bun run dev`) ────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tanchi
REDIS_URL=redis://localhost:6379

# ── PostgreSQL (used by docker compose to provision the DB) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tanchi

# ── Public URLs ──────────────────────────────────────────────
# Prod: your domains, e.g. https://app.tanchi.io and https://api.tanchi.io
# (cookie auth needs HTTPS + a shared parent domain; see README).
APP_URL=http://localhost:5173
AUTH_BASE_URL=http://localhost:3000
# Base API URL inlined into the web build at build time.
VITE_API_URL=http://localhost:3000

# ── Secrets (REQUIRED — the API won't boot without them) ─────
# openssl rand -hex 32   (min 32 chars)
AUTH_SECRET=change-me-with-a-32-plus-char-random-secret
# openssl rand -base64 32   (min 44 chars)
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes

# false (the default): no email verification at all. Signing up logs you
# straight into the app, no confirmation email is sent. This is the self-host
# default, and the only value that works without a mailer.
# true: signing up still logs you in, but the app shows the "verify your email"
# screen and every authenticated API route returns 403 until the link in the
# email is clicked. Needs MAIL_SMTP_HOST or RESEND_API_KEY — the API refuses to
# boot with true and no mailer, since no account could ever be verified.
REQUIRE_EMAIL_VERIFICATION=false

# Set true once your accounts are created: blocks any new sign-up (and the
# API-key usage a stranger reaching your instance could trigger).
DISABLE_SIGNUP=false

# Number of trusted reverse proxies in front of the API. IP-based rate limits
# (sign-in, sign-up, password reset) read the client IP from X-Forwarded-For
# only through this many trusted hops; 0 = ignore XFF and use the direct socket
# IP (correct when the API is exposed directly). Set to 1 behind a single proxy
# (nginx/Caddy/Traefik). The all-in-one image sets this to 1 automatically.
TRUSTED_PROXY_COUNT=0

# ── AI provider ──────────────────────────────────────────────
# cli | api | anthropic | openai | gemini | kimi
# "api" is an alias of "anthropic" and stays the default for the hosted product.
# "cli" is Claude-only (it spawns the local claude binary); every other provider
# is API-key only. On a server, prefer an API key: a vendor CLI is tied to an
# interactive subscription and its OAuth re-auth, which breaks a nightly batch.
LLM_PROVIDER=api
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Only for LLM_PROVIDER=cli (local dev with the Claude CLI installed).
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_TIMEOUT_MS=600000

# Web research sources every fact in a dossier. Every provider above ships a
# native web search, so this is optional. Kimi's is the weakest — Moonshot flags
# it as being reworked — so delegate research here if dossiers come out thin,
# while keeping Kimi for the writing.
# LLM_RESEARCH_PROVIDER=gemini

# Per-agent model override (optional — defaults in apps/api/README.md).
# Env var names use the internal agent keys (chasseur = Hunter, analyste = Analyst).
# The value must belong to the active provider's model list.
# LLM_MODEL_CHASSEUR=claude-sonnet-5
# LLM_MODEL_PROFILER=claude-opus-4-8
# LLM_MODEL_COPYWRITER=claude-sonnet-5
# LLM_MODEL_ANALYSTE=claude-sonnet-5
# LLM_MODEL_REWARD=claude-haiku-4-5
# LLM_MODEL_CHAT=claude-sonnet-5

# ── Enrichment (sourcing) ────────────────────────────────────
# Optional. Without a key, the Hunter finds contacts via AI search.
HUNTER_API_KEY=

# ── Analytics (hosted offering only) ─────────────────────────
# Optional PostHog project key. Unset = analytics fully disabled (self-host
# default). Server events (sign-ups, onboarding, sends, subscriptions) use
# POSTHOG_API_KEY; the web build needs VITE_POSTHOG_KEY at build time.
# POSTHOG_API_KEY=phc_xxx
# POSTHOG_HOST=https://eu.i.posthog.com
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ── Workers ──────────────────────────────────────────────────
# Start the BullMQ workers at boot.
RUN_WORKERS=true

# ── Billing (hosted offering only) ───────────────────────────
# Self-hosted: keep false (default) — no limits, Stripe never called.
# When true, orgs get a 14-day trial then must subscribe to the Solo plan;
# the price itself is configured on the Stripe product, the app only needs
# its price id. All three STRIPE_* vars become required.
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_SOLO_PRICE_ID=price_xxx

# ── System mailer (transactional: verification, invitations) ──
# Resend is NOT required. Provider order: generic SMTP (if MAIL_SMTP_HOST set)
# > Resend (if RESEND_API_KEY set) > dev log. From address = RESEND_FROM_EMAIL
# ?? MAIL_FROM_EMAIL. The sending domain must be verified with your provider.
MAIL_FROM_EMAIL=Tanchi <no-reply@tanchi.io>
# Option A — generic SMTP (recommended self-hosted). Wins if MAIL_SMTP_HOST is set.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=false
# Option B — Resend (SaaS, optional). Leave MAIL_SMTP_HOST empty to use it.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Tanchi <hello@notifications.tanchi.io>
