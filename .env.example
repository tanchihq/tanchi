# ─────────────────────────────────────────────────────────────
# Tanchi — configuration self-hosted (lue par docker-compose)
# Copier en `.env` et remplir. Ne jamais commiter le `.env` réel.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tanchi

# ── URLs publiques ───────────────────────────────────────────
# En prod, mettre vos domaines : https://app.tanchi.io et https://api.tanchi.io
# (l'auth par cookie exige HTTPS + un domaine parent commun ; voir README).
# En local, laisser les valeurs ci-dessous.
# APP_URL : origine du front, autorisée par le CORS de l'API.
APP_URL=http://localhost:8080
# AUTH_BASE_URL : URL publique de l'API.
AUTH_BASE_URL=http://localhost:3000
# VITE_API_URL : base d'API inlinée dans le build du front (build-time).
VITE_API_URL=http://localhost:3000

# ── Secrets (obligatoires) ───────────────────────────────────
# openssl rand -hex 32
AUTH_SECRET=change-me-with-a-32-plus-char-random-secret
# openssl rand -base64 32
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes

# En self-hosted sans mailer, mettre false pour auto-valider les comptes.
REQUIRE_EMAIL_VERIFICATION=false

# ── IA (Anthropic) ───────────────────────────────────────────
# En conteneur, "api" est recommandé (le batch nocturne tourne dessus).
LLM_PROVIDER=api
ANTHROPIC_API_KEY=

# Modèle par agent (optionnel — défauts dans apps/api/README.md).
# LLM_MODEL_CHASSEUR=claude-sonnet-5
# LLM_MODEL_PROFILER=claude-opus-4-8
# LLM_MODEL_COPYWRITER=claude-sonnet-5
# LLM_MODEL_ANALYSTE=claude-sonnet-5
# LLM_MODEL_REWARD=claude-haiku-4-5
# LLM_MODEL_CHAT=claude-sonnet-5

# ── Enrichissement (sourcing) ────────────────────────────────
# Optionnel. Sans clé, le Chasseur trouve les contacts par recherche IA.
HUNTER_API_KEY=

# ── Workers ──────────────────────────────────────────────────
# Démarrer les workers BullMQ au boot.
RUN_WORKERS=true

# ── Mailer système (transactionnel : vérif compte, invitations) ──
# Resend N'EST PAS requis. Ordre : SMTP générique > Resend > log dev.
MAIL_FROM_EMAIL=Tanchi <no-reply@tanchi.io>
# Option A — SMTP générique (recommandé self-hosted). Prioritaire s'il est défini.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=false
# Option B — Resend (SaaS, optionnel).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Tanchi <onboarding@resend.dev>
