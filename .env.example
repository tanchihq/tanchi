# ─────────────────────────────────────────────────────────────
# Tanchi — single .env for the whole monorepo.
# Copy to `.env` and fill in. Used by BOTH:
#   - local dev (`bun run dev`) — reads DATABASE_URL / REDIS_URL below
#   - docker compose — builds DATABASE_URL / REDIS_URL from POSTGRES_* and the
#     service hostnames, overriding the localhost values below inside the containers.
# Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# ── Local dev connections (used by `bun run dev`) ────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tanchi
REDIS_URL=redis://localhost:6379

# ── PostgreSQL (used by docker compose to provision the DB) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tanchi

# ── Public URLs ──────────────────────────────────────────────
# Prod: your domains, e.g. https://app.tanchi.io and https://api.tanchi.io
# (cookie auth needs HTTPS + a shared parent domain; see README).
APP_URL=http://localhost:5173
AUTH_BASE_URL=http://localhost:3000
# Base API URL inlined into the web build at build time.
VITE_API_URL=http://localhost:3000

# ── Secrets (REQUIRED — the API won't boot without them) ─────
# openssl rand -hex 32   (min 32 chars)
AUTH_SECRET=change-me-with-a-32-plus-char-random-secret
# openssl rand -base64 32   (min 44 chars)
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes

# Self-hosted without a mailer: set false to auto-activate accounts.
REQUIRE_EMAIL_VERIFICATION=false

# Set true once your accounts are created: blocks any new sign-up (and the
# API-key usage a stranger reaching your instance could trigger).
DISABLE_SIGNUP=false

# ── AI (Anthropic) ───────────────────────────────────────────
# In a container, "api" is recommended (the nightly batch runs on it).
LLM_PROVIDER=api
ANTHROPIC_API_KEY=
# Only for LLM_PROVIDER=cli (local dev with the Claude CLI installed).
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_TIMEOUT_MS=600000

# Per-agent model override (optional — defaults in apps/api/README.md).
# Env var names use the internal agent keys (chasseur = Hunter, analyste = Analyst).
# LLM_MODEL_CHASSEUR=claude-sonnet-5
# LLM_MODEL_PROFILER=claude-opus-4-8
# LLM_MODEL_COPYWRITER=claude-sonnet-5
# LLM_MODEL_ANALYSTE=claude-sonnet-5
# LLM_MODEL_REWARD=claude-haiku-4-5
# LLM_MODEL_CHAT=claude-sonnet-5

# ── Enrichment (sourcing) ────────────────────────────────────
# Optional. Without a key, the Hunter finds contacts via AI search.
HUNTER_API_KEY=

# ── Workers ──────────────────────────────────────────────────
# Start the BullMQ workers at boot.
RUN_WORKERS=true

# ── System mailer (transactional: verification, invitations) ──
# Resend is NOT required. Provider order: generic SMTP (if MAIL_SMTP_HOST set)
# > Resend (if RESEND_API_KEY set) > dev log. From address = RESEND_FROM_EMAIL
# ?? MAIL_FROM_EMAIL. The sending domain must be verified with your provider.
MAIL_FROM_EMAIL=Tanchi <no-reply@tanchi.io>
# Option A — generic SMTP (recommended self-hosted). Wins if MAIL_SMTP_HOST is set.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=false
# Option B — Resend (SaaS, optional). Leave MAIL_SMTP_HOST empty to use it.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Tanchi <hello@notifications.tanchi.io>
