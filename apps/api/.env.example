# Environnement
NODE_ENV=development
PORT=3000

# PostgreSQL — données métier + tables Better Auth
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tanchi

# Redis (BullMQ) — batch du soir, relances, analyse, polling des réponses.
REDIS_URL=redis://localhost:6379

# URLs
APP_URL=http://localhost:5173
AUTH_BASE_URL=http://localhost:3000

# Better Auth — secret de signature des sessions/cookies (min 32 caractères).
# Générer : openssl rand -hex 32
AUTH_SECRET=change-me-with-a-32-plus-char-random-secret

# Chiffrement des secrets (mailbox SMTP/IMAP, clés) au repos (min 44 caractères).
# Générer : openssl rand -base64 32
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes

# Bloquer la connexion tant que l'email n'est pas vérifié.
# Self-hosted : mettre "false" pour auto-valider les comptes.
REQUIRE_EMAIL_VERIFICATION=true

# ── IA ──────────────────────────────────────────────────────
# "cli" (binaire claude local, défaut) ou "api" (ANTHROPIC_API_KEY requis).
# Les actions du chat (créer/réécrire...) nécessitent "api" ou le pont MCP en cli.
LLM_PROVIDER=cli
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_TIMEOUT_MS=600000
ANTHROPIC_API_KEY=

# Modèle par agent (optionnel — sinon défauts : sonnet-5 partout, reward=haiku, profiler=opus).
# Autorisés : claude-opus-4-8, claude-opus-4-7, claude-sonnet-5, claude-sonnet-4-6, claude-haiku-4-5
# LLM_MODEL_CHASSEUR=claude-sonnet-5
# LLM_MODEL_PROFILER=claude-opus-4-8
# LLM_MODEL_COPYWRITER=claude-sonnet-5
# LLM_MODEL_ANALYSTE=claude-sonnet-5
# LLM_MODEL_REWARD=claude-haiku-4-5
# LLM_MODEL_CHAT=claude-sonnet-5

# ── Enrichissement (sourcing) ───────────────────────────────
# Optionnel. Sans clé, le Chasseur trouve les contacts par recherche IA.
HUNTER_API_KEY=

# ── Workers ─────────────────────────────────────────────────
# Démarrer les workers BullMQ au boot. "false" en dev sans Redis.
RUN_WORKERS=true

# ── Mailer système (transactionnel : vérif compte, invitations) ──
# Resend N'EST PAS requis. Ordre : SMTP générique > Resend > log dev.
# Adresse expéditrice (générique).
MAIL_FROM_EMAIL=Tanchi <no-reply@tanchi.io>
# Option A — SMTP générique (recommandé self-hosted). Prioritaire s'il est défini.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_SECURE=false
# Option B — Resend (SaaS, optionnel). RESEND_FROM_EMAIL prioritaire sur MAIL_FROM_EMAIL si défini.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Tanchi <onboarding@resend.dev>
