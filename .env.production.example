# Variables à coller dans l'onglet Environment de l'app Dokploy.
# Ne commite jamais les valeurs réelles.

# --- Runtime ---
NODE_ENV=production
PORT=3000

# --- Postgres (base provisionnée dans Dokploy) ---
# Utilise le host interne de ton service Postgres Dokploy, pas localhost.
DATABASE_URL=postgres://sweeleads:strong-password@sweeleads-postgres:5432/sweeleads

# --- Redis (provisionné dans Dokploy) ---
REDIS_URL=redis://sweeleads-redis:6379

# --- URLs publiques ---
# APP_URL : origine du front autorisée par le CORS.
APP_URL=https://app.sweeleads.com
# AUTH_BASE_URL : URL publique de cette API (le domaine attaché dans Dokploy).
AUTH_BASE_URL=https://api.sweeleads.com

# --- Secrets (openssl rand -base64 32) ---
AUTH_SECRET=change-me-32-plus-char-random-secret
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes

# --- LLM : en conteneur, "api" obligatoire (pas de CLI claude dispo) ---
LLM_PROVIDER=api
ANTHROPIC_API_KEY=sk-ant-...

# --- Sourcing (facultatif) ---
HUNTER_API_KEY=

# --- Emails transactionnels (Resend par défaut) ---
REQUIRE_EMAIL_VERIFICATION=true
RESEND_FROM_EMAIL=SweeLeads <noreply@ton-domaine.com>
RESEND_API_KEY=re_...
# Override SMTP générique si tu n'utilises pas Resend (prioritaire) :
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_SMTP_SECURE=false

# --- Workers BullMQ (batch du soir + reward + sequences) ---
RUN_WORKERS=true

# --- Migrations SQL au boot (idempotent) ---
RUN_MIGRATIONS=true
