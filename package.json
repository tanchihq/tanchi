{
  "name": "tanchi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter '@app/api' dev",
    "dev:web": "bun run --filter '@app/web' dev",
    "build": "bun run --filter '@app/web' build",
    "typecheck": "bun run --filter '@app/api' typecheck && bun run --filter '@app/web' typecheck",
    "test": "bun test apps/api",
    "migrate": "bun run --filter '@app/api' migrate"
  }
}
